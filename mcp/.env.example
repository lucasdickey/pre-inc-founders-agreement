# Atlas Incorporation MCP — environment configuration
#
# This is a PROOF OF CONCEPT. Auth and storage are EMULATED so the server can
# run with zero external dependencies. The variables below show where the real
# Clerk / database / KMS integrations would be wired in.

# --- Storage (emulated) ---
# Directory where the emulated database + secure vault JSON files live.
# Defaults to ./.data next to the server. In production this would be a
# Postgres/Supabase connection string instead.
ATLAS_DATA_DIR=./.data

# --- Auth (emulated Clerk) ---
# When AUTH_MODE=emulated (default) the server issues its own opaque session
# tokens and never calls Clerk. Set AUTH_MODE=clerk and provide the keys below
# to swap in real Clerk verification (not implemented in this POC).
AUTH_MODE=emulated
# CLERK_SECRET_KEY=sk_test_xxx
# CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Secure vault (emulated) ---
# In production this would be a KMS key id used for envelope encryption of PII
# (SSN/ITIN, EIN, DOB). In emulated mode the vault only seals + masks values.
# ATLAS_KMS_KEY_ID=
