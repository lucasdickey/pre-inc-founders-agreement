{
  "name": "atlas-incorporation-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proof-of-concept MCP server that replicates the Stripe Atlas Delaware C-Corp incorporation application as a set of agent-callable tools.",
  "bin": {
    "atlas-incorporation-mcp": "./server.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20"
  }
}
